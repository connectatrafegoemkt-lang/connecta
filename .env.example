# Copie para .env (na VPS) ou .env.local (no seu computador) e preencha.
# NUNCA commite o arquivo preenchido. Valores abaixo são FICTÍCIOS.

# Endereço do CRM (o registro DNS "A" deste nome aponta para o IP da VPS)
CRM_DOMAIN=sistema.connectatrafego.com.br

# Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
# Somente servidor/worker. Bypassa RLS: nunca expor ao navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# SOMENTE NO WORKER. Chave de 32 bytes (base64) que cifra as credenciais do WhatsApp.
# Perder esta chave = todos os tenants precisam ler o QR de novo.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WHATSAPP_CREDENTIALS_KEY=troque-por-uma-chave-base64-de-32-bytes

# Worker do WhatsApp (npm run worker) — usa as mesmas SUPABASE_* acima
SUPABASE_URL=http://127.0.0.1:54321
LOG_LEVEL=info

# Atendimento por IA — chave da CONNECTA na Anthropic (console.anthropic.com).
# Paga o uso de todos os clientes; o consumo de cada um fica registrado no sistema.
ANTHROPIC_API_KEY=sua-chave-da-anthropic-aqui
# Modelo usado pela IA (padrão: claude-opus-5-5)
AI_MODEL=claude-opus-5-5
